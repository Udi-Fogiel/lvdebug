
\_codedecl \lvdset {Visual debugging <1.1, 2026-04-24>}

\_directlua{
  local resolved = kpse.find_file("luakeyval.lua")
  if resolved then
      require("lua-visual-debug-keys")
  end
  local lvd = require("lua-visual-debug")
  callback.add_to_callback('pre_shipout_filter', lvd.show_page_elements, 'lvd')
}

\_endcode
